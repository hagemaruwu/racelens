#!/usr/bin/env bash
#
# RaceLens CLI Runner
# Automatically configures dynamic interposition on Linux (LD_PRELOAD)
# and macOS (DYLD_INSERT_LIBRARIES).
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION="1.0.0 (2026)"

function print_usage() {
    cat <<EOF
RaceLens - Pthread Data Race Detector $VERSION
Usage: racelens [OPTIONS] <command> [args...]

Options:
  -h, --help       Show this help message and exit
  -v, --version    Show version information

Examples:
  racelens ./tests/test_racy_counter
  racelens ./my_multithreaded_app arg1 arg2
EOF
}

if [[ $# -eq 0 ]]; then
    print_usage
    exit 1
fi

case "$1" in
    -h|--help)
        print_usage
        exit 0
        ;;
    -v|--version)
        echo "RaceLens v$VERSION - Dynamic Pthread Data Race Detector"
        exit 0
        ;;
esac

OS_TYPE="$(uname -s)"

if [[ "$OS_TYPE" == "Linux" ]]; then
    LIB_PATH="$SCRIPT_DIR/build/libracelens.so"
    if [[ ! -f "$LIB_PATH" ]]; then
        echo "[RaceLens] Error: Shared library not found at $LIB_PATH. Run 'make' first." >&2
        exit 1
    fi
    export LD_PRELOAD="$LIB_PATH"
    exec "$@"

elif [[ "$OS_TYPE" == "Darwin" ]]; then
    LIB_PATH="$SCRIPT_DIR/build/libracelens.dylib"
    if [[ ! -f "$LIB_PATH" ]]; then
        echo "[RaceLens] Error: Dynamic library not found at $LIB_PATH. Run 'make' first." >&2
        exit 1
    fi
    export DYLD_INSERT_LIBRARIES="$LIB_PATH"
    export DYLD_FORCE_FLAT_NAMESPACE=1
    exec "$@"

else
    echo "[RaceLens] Unsupported operating system: $OS_TYPE" >&2
    exit 1
fi
